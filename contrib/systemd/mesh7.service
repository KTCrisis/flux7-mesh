# flux7-mesh as a systemd user service. install.sh --service puts it in
# ~/.config/systemd/user/ and starts it; by hand:
#
#   mkdir -p ~/.config/systemd/user
#   cp contrib/systemd/mesh7.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now mesh7
#   loginctl enable-linger "$USER"     # keep it running when you log out
#
# %h is your home directory. Adjust ExecStart if mesh7 or the config live
# elsewhere. A service has no terminal: keep `approval.channel: queue` in the
# config, and answer approvals with `mesh approve <id>` or the console.
#
# Where the user manager is unavailable (some WSL setups), use a system unit
# instead: install.sh --system.

[Unit]
Description=flux7-mesh governance proxy (mesh7)
Documentation=https://docs.flux7.art/mesh7/deployment-modes/
After=network.target

[Service]
ExecStart=%h/.local/bin/mesh7 serve --config %h/.config/mesh7/config.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
